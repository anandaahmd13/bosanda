{
  "name": "bosanda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "typecheck": "pnpm run typecheck:root && pnpm --dir apps/web run typecheck && pnpm --dir apps/admin run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "build:apps": "pnpm --dir apps/web run build && pnpm --dir apps/admin run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build:apps",
    "db:migrate": "tsx packages/database/src/cli/migrate.ts",
    "admin:bootstrap": "tsx packages/database/src/cli/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@noble/ciphers": "2.2.0",
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.11.0",
    "next": "16.2.12",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "undici": "8.9.0",
    "zod": "4.4.3"
  }
}
