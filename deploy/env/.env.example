# Bosanda environment template
#
# Every variable below is taken from packages/config/src/env.ts (envSchema).
# That file is the single source of truth: it validates at boot and refuses to
# start a half-configured process. If you add a variable there, add it here.
#
# ---------------------------------------------------------------------------
# HOW TO USE
# ---------------------------------------------------------------------------
# Do NOT deploy this file as-is. Split it per service so each process only sees
# the secrets it needs (§16 least privilege), and note that the config schema
# validates the WHOLE schema in every process — so each service's env file still
# needs the required variables (DATABASE_URL and all five secrets), even if that
# service never uses one of them. The split that is meaningful in v1 is between
# the app users and the backup user, plus keeping PAKASIR_API_KEY out of the
# storefront.
#
#   /etc/bosanda/gateway.env   owned root:bosanda        chmod 0640
#   /etc/bosanda/worker.env    owned root:bosanda        chmod 0640
#   /etc/bosanda/web.env       owned root:bosanda        chmod 0640
#   /etc/bosanda/admin.env     owned root:bosanda        chmod 0640
#   /etc/bosanda/backup.env    owned root:bosanda-backup chmod 0640
#
# systemd reads EnvironmentFile as root BEFORE dropping to User=, so the service
# user needs read access only. 0640 root:bosanda is the tightest that works.
# The task brief says 0600 root-owned; 0640 root:<group> is the same guarantee
# against other users while remaining readable by the service group. If you
# prefer literal 0600 root:root, that also works with systemd — pick one and
# record it in docs/operations.md.
#
#   install -o root -g bosanda -m 0640 /dev/null /etc/bosanda/gateway.env
#
# ---------------------------------------------------------------------------
# GENERATING THE SECRETS
# ---------------------------------------------------------------------------
# Four of the five secrets must be exactly 32 bytes, base64-encoded. Generate
# each one SEPARATELY — never copy one value into another field:
#
#   openssl rand -base64 32
#
# Generate all five at once, correctly labelled:
#
#   for v in PROVIDER_ENCRYPTION_KEY API_KEY_ENCRYPTION_KEY \
#            API_KEY_LOOKUP_SECRET SESSION_SECRET; do \
#     printf '%s=%s\n' "$v" "$(openssl rand -base64 32)"; done
#
# THE FIVE SECRETS MUST ALL BE DISTINCT VALUES. This is not advice — the config
# layer enforces it: assertSecretsAreDistinct() in packages/config/src/env.ts
# throws ConfigError and the process refuses to boot if any two match. The
# reason is blast radius: reusing one value means a single leak compromises
# credential encryption, key lookup, sessions, and payment verification at once.
#
# Every placeholder below is an obvious non-secret. Replace all of them.
# Never commit a real value. .gitignore already excludes .env and .env.*
# (with an exception for this .example file).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production. Set to production on the VPS.
# The systemd units already set this via Environment=, so it can be omitted
# from the env files themselves.
NODE_ENV=production

# trace | debug | info | warn | error | fatal. Default: info.
# Do NOT run trace/debug in production: they raise log volume sharply and,
# although the logger redacts (§17), the safest posture is less data.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Required. Must start with postgres:// or postgresql:// (validated).
# PostgreSQL must NOT be publicly reachable (§16) — keep it on localhost or a
# private interface. Prefer the unix socket or 127.0.0.1.
# URL-encode any special characters in the password.
DATABASE_URL=postgresql://bosanda:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/bosanda

# Pool size per process, 1..200. Default: 10.
# Budget across ALL processes: gateway + worker + web + admin must stay under
# PostgreSQL's max_connections (default 100) with headroom for psql and backups.
# 10 each = 40 total, which is safe on a default install.
DATABASE_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Service bind
# ---------------------------------------------------------------------------

# Gateway port, 1..65535. Default: 4000. Must match proxy_pass in
# deploy/nginx/sites-available/api.bosanda.dev.conf.
GATEWAY_PORT=4000

# Default: 127.0.0.1. Keep it loopback — nginx is the only entry point, and
# binding 0.0.0.0 would let a client bypass TLS, the rate limits, and every
# security header in the vhost.
GATEWAY_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Secrets (§16) — all five REQUIRED and MUTUALLY DISTINCT
# ---------------------------------------------------------------------------

# 32 bytes base64. Encrypts Kiro provider credentials at rest (refresh tokens,
# access tokens, OIDC client secrets) with XChaCha20-Poly1305.
# Losing this makes every stored provider account undecryptable — you would have
# to re-import every Kiro account. Back it up OUTSIDE the database (§18: "encryption
# keys are stored separately" from the ciphertext backups).
PROVIDER_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32_UNIQUE_VALUE_1

# 32 bytes base64. Encrypts customer API keys so the dashboard eye toggle can
# decrypt and display them (§12). Losing it means customers can no longer reveal
# existing keys; authentication still works, because that path uses the lookup
# digest below, not this ciphertext.
API_KEY_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32_UNIQUE_VALUE_2

# 32 bytes base64. HMAC-SHA-256 key for the API key lookup digest used on every
# authenticated request. Losing or changing it invalidates EVERY live customer
# key at once, because no incoming key will hash to a stored digest.
# Treat rotation of this one as a customer-visible event — see scripts/rotate-keys.md.
API_KEY_LOOKUP_SECRET=REPLACE_ME_openssl_rand_base64_32_UNIQUE_VALUE_3

# 32 bytes base64. Signs website session cookies. Rotating it logs everyone out,
# which is a legitimate and fast containment action during an incident.
SESSION_SECRET=REPLACE_ME_openssl_rand_base64_32_UNIQUE_VALUE_4

# Pakasir webhook authenticity (§13). Minimum 16 characters — this one is NOT
# required to be 32-byte base64, because its value is dictated by Pakasir, not by
# us. Use whatever secret the Pakasir dashboard issues. It must still differ from
# the four above.
PAKASIR_WEBHOOK_SECRET=REPLACE_ME_WITH_SECRET_FROM_PAKASIR_DASHBOARD

# Monotonic integer, min 1. Default: 1. Stamped onto newly written ciphertext so
# key rotation can proceed without rewriting history. Bump ONLY as part of the
# documented rotation procedure (scripts/rotate-keys.md) — raising it without
# retaining the previous key makes existing rows unreadable, and keyringFromEnv()
# will throw ConfigError on any row written at an older version.
ENCRYPTION_KEY_VERSION=1

# ---------------------------------------------------------------------------
# Payments (§13)
# ---------------------------------------------------------------------------

# Default: https://pakasir.com. Override only for a sandbox endpoint.
PAKASIR_BASE_URL=https://pakasir.com

# Pakasir project slug. Default: bosanda.
PAKASIR_PROJECT=bosanda

# OPTIONAL (no default). Needed by the worker for reconciliation status polls
# (§13 "Reconciliation"). Omit it from web.env — the storefront never calls the
# Pakasir API directly; it redirects the browser.
PAKASIR_API_KEY=REPLACE_ME_WITH_PAKASIR_API_KEY

# ---------------------------------------------------------------------------
# Kiro adapter kill switches (§3)
# ---------------------------------------------------------------------------

# MASTER KILL SWITCH. Default: false — and it must STAY false until the owner has
# produced PASS evidence for gates G0-G4 in docs/direct-adapter-gate.md against
# real Kiro accounts. While false: all Kiro models are hidden from /v1/models,
# API requests get a sanitized 503, and NO payment may activate a Kiro package.
# Accepts true|false|1|0.
KIRO_DIRECT_ENABLED=false

# Default: true. Emergency disable for tool use only (§3), leaving plain text
# generation working. Use when Claude Code tool calls break but chat still works —
# a narrower blast radius than the master switch.
KIRO_TOOL_USE_ENABLED=true

# Default: us-east-1.
KIRO_DEFAULT_REGION=us-east-1

# cli | ide. Default: cli. §2 prefers the CLI persona for v1; IDE support is
# behind this flag and is not required for launch.
KIRO_PERSONA=cli

# Comma-separated, default empty. Per-region kill switch (§3).
#   KIRO_DISABLED_REGIONS=eu-west-1,ap-southeast-1
KIRO_DISABLED_REGIONS=

# Comma-separated PUBLIC model IDs, default empty. Per-model kill switch (§3).
# Use this the moment one model starts failing the compatibility probe while the
# others are healthy.
KIRO_DISABLED_MODELS=

# ---------------------------------------------------------------------------
# Limits and timeouts (§7, §16)
# ---------------------------------------------------------------------------

# Max concurrent in-flight requests per customer API key. Default: 5 (§7).
# Raising this raises the bounded negative-overage window described in §10,
# because up to this many streams may each finish past a zero balance.
KEY_MAX_ACTIVE_REQUESTS=5

# Max requests per minute per customer API key. Default: 100 (§7).
# The nginx edge limit is deliberately looser and IP-based; this is the
# authoritative per-key limit.
KEY_MAX_REQUESTS_PER_MINUTE=100

# Provider cooldown after a failed attempt, ms, min 1000. Default: 30000 (§7).
PROVIDER_COOLDOWN_MS=30000

# Ceiling for exponential cooldown escalation, ms. Default: 900000 (15 min) (§7).
PROVIDER_COOLDOWN_MAX_MS=900000

# Max gap between upstream chunks before the turn is aborted, ms.
# Default: 120000. Guards against an upstream that accepts the request then
# stalls forever (§3 G2).
UPSTREAM_IDLE_TIMEOUT_MS=120000

# Absolute per-turn ceiling, ms. Default: 600000 (10 min).
# nginx proxy_read_timeout is set to 600s to match; if you raise this, raise the
# nginx timeout AND TimeoutStopSec in bosanda-gateway.service, or long turns will
# be cut by the proxy or by a deploy.
UPSTREAM_HARD_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------

# Must be valid URLs. Used for CORS, cookie domains, redirects, and the
# checkout return URL. Must match the nginx server_name values exactly, or
# CSRF/Origin validation will reject legitimate requests.
PUBLIC_WEB_URL=https://bosanda.dev
PUBLIC_ADMIN_URL=https://admin.bosanda.dev
PUBLIC_API_URL=https://api.bosanda.dev

# ---------------------------------------------------------------------------
# Backup-only settings (scripts/backup.sh, scripts/restore.sh)
# ---------------------------------------------------------------------------
# NOT part of envSchema — these are consumed by the shell scripts, so they
# belong only in /etc/bosanda/backup.env.

# Where encrypted dumps are written. Must be writable by bosanda-backup and is
# the only ReadWritePaths entry in bosanda-backup.service.
# BOSANDA_BACKUP_DIR=/var/backups/bosanda

# Days of dumps to keep. Older ones are pruned by backup.sh.
# BOSANDA_BACKUP_RETENTION_DAYS=14

# GPG recipient for encrypting dumps at rest (§18: "backups are encrypted").
# Import the PUBLIC key only on the VPS; keep the private key offline so a VPS
# compromise cannot decrypt the backups.
# BOSANDA_BACKUP_GPG_RECIPIENT=ops@bosanda.dev

# Standard libpq variables for pg_dump/psql.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=bosanda
# PGUSER=bosanda
# PGPASSWORD=REPLACE_WITH_DB_PASSWORD
